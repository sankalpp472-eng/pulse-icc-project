# Copy this to .env and fill in your values

# --- LLM Backend ---
# Options: groq (default) | ollama
LLM_BACKEND=groq

# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
# Tool-calling models on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (only needed if LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- User simulator (optional; defaults to the agent's model) ---
# USER_MODEL=openai/gpt-oss-20b

# --- LangSmith tracing (optional; development only, keep OFF for latency experiments) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=pulse-agent
