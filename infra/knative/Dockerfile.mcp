# One image for all MCP tool servers (14 airline + 16 retail). Each Knative service runs it with
# TOOLS=<one tool name> (and DOMAIN=retail for retail), so every tool is its own serverless function.
# Built from the repository root (deploy.sh does it unless SKIP_BUILD=1):
#   docker build -f infra/knative/Dockerfile.mcp -t <repo>/pulse-mcp-tools:<tag> .
# Only the tool code goes in (the repository's .dockerignore). /home/app/mcp_server.py starts pulse.agent.mcp_server,
# so `python mcp_server.py [--seed]` works with this image and with the older published ones alike.
FROM python:3.11-slim

RUN pip install --no-cache-dir "mcp>=2.3" "uvicorn>=0.30" "redis>=5"

RUN useradd -m app
WORKDIR /home/app
COPY pulse/__init__.py pulse/paths.py pulse/
COPY pulse/agent/__init__.py pulse/agent/mcp_server.py pulse/agent/
COPY pulse/agent/tau_airline/ pulse/agent/tau_airline/
COPY pulse/agent/tau_retail/ pulse/agent/tau_retail/
RUN printf 'import runpy\nrunpy.run_module("pulse.agent.mcp_server", run_name="__main__")\n' > mcp_server.py
USER app

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    TOOLS=all
EXPOSE 8080
CMD ["python", "mcp_server.py"]
