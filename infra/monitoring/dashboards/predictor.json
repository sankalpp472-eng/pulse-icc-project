{
 "uid": "pulse-predictor",
 "title": "Pulse predictor",
 "tags": [
  "pulse"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "panels": [
  {
   "type": "timeseries",
   "title": "Predictor latency p95 (target 50 ms, NFR-4)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, component) (rate(predictor_request_seconds_bucket[1m])))",
     "legendFormat": "{{component}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 0.05
       }
      ]
     },
     "custom": {
      "thresholdsStyle": {
       "mode": "line"
      }
     }
    },
    "overrides": []
   },
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Hints per second",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (component) (rate(predictor_hints_total[1m]))",
     "legendFormat": "{{component}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "id": 2
  },
  {
   "type": "timeseries",
   "title": "Prewarm candidates per minute, by tool",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (rate(predictor_prewarm_candidates_total[1m])) * 60",
     "legendFormat": "{{tool}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Controller: warm-up failures and evictions (5 min)",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (tool) (increase(pulse_controller_failures_total[5m]))",
     "legendFormat": "failed {{tool}}",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(pulse_controller_evictions_total[5m]))",
     "legendFormat": "evicted (all tools)",
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "id": 4
  }
 ]
}
