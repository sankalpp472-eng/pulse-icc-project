{
 "uid": "pulse-overview",
 "title": "Pulse overview",
 "tags": [
  "pulse"
 ],
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "10s",
 "timezone": "browser",
 "panels": [
  {
   "type": "timeseries",
   "title": "Ready tool pods, by tool",
   "description": "Knative tool pods that are ready. Their area over time is the warm pod-seconds (NFR-7).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (label_serving_knative_dev_service) (kube_pod_status_ready{namespace=\"default\",condition=\"true\"} * on (namespace, pod) group_left (label_serving_knative_dev_service) kube_pod_labels{namespace=\"default\",label_serving_knative_dev_service!=\"\"})",
     "legendFormat": "{{label_serving_knative_dev_service}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 1
  },
  {
   "type": "stat",
   "title": "Warm tool pod-seconds (time range)",
   "description": "Ready tool pods integrated over the dashboard's time range (15 s resolution).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum_over_time((sum(kube_pod_status_ready{namespace=\"default\",condition=\"true\"} * on (namespace, pod) group_left (label_serving_knative_dev_service) kube_pod_labels{namespace=\"default\",label_serving_knative_dev_service!=\"\"}))[$__range:15s]) * 15",
     "legendFormat": "pod-seconds",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Cold share of tool calls (time range)",
   "description": "Runner calls slower than 1 s (live rule; the run's calls.csv also uses the pod rule).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum(increase(pulse_tool_calls_total{temperature=\"cold\"}[$__range])) / sum(increase(pulse_tool_calls_total[$__range]))",
     "legendFormat": "cold",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "Tool call latency (runner)",
   "description": "As the agent sees it: from the replay runner (w1_replay.py --metrics-port).",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.5, sum by (le) (rate(pulse_tool_call_seconds_bucket[1m])))",
     "legendFormat": "p50",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le) (rate(pulse_tool_call_seconds_bucket[1m])))",
     "legendFormat": "p95",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.99, sum by (le) (rate(pulse_tool_call_seconds_bucket[1m])))",
     "legendFormat": "p99",
     "refId": "C"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Tool calls per minute, cold vs warm",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (temperature) (rate(pulse_tool_calls_total[1m])) * 60",
     "legendFormat": "{{temperature}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Prewarms per minute (controller)",
   "description": "Warm-ups the prewarm controller did. cold=true: its ping started the pod.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (cold) (rate(pulse_controller_warmups_total[1m])) * 60",
     "legendFormat": "tool was cold: {{cold}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Warm-up ping latency p95 (controller)",
   "description": "With cold=true this is about the tool's cold start.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "histogram_quantile(0.95, sum by (le, cold) (rate(pulse_controller_ping_seconds_bucket[5m])))",
     "legendFormat": "cold: {{cold}}",
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "id": 7
  }
 ]
}
