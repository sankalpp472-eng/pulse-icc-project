# Copy this to .env and fill in your values (scripts/setup.sh does the copy). Never commit .env.

# --- LLM Backend (the agent and the simulated customer) ---
# Options: groq (default) | ollama
LLM_BACKEND=groq

# --- Groq (free tier works) ---
# One key, or several numbered keys used in turn (spreads the per-minute limits; the speculator uses them too)
GROQ_API_KEY=your_groq_api_key_here
# GROQ_API_KEY_1=...
# GROQ_API_KEY_2=...
# Tool-calling models on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (only needed if LLM_BACKEND=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# --- User simulator (optional; defaults to the agent's model) ---
# USER_MODEL=openai/gpt-oss-20b

# --- The speculator predictor (PREDICTOR=speculator) ---
# Default: the Groq keys above, model openai/gpt-oss-20b. Or any OpenAI-compatible server, e.g. a local Ollama:
# SPEC_BASE_URL=http://127.0.0.1:11434/v1
# SPEC_API_KEY=ollama            # any non-empty value for a local server
# SPEC_MODEL=qwen3:8b            # a model that server has
# SPEC_MAX_TOKENS=150
# SPEC_TIMEOUT_S=5               # a later guess is useless: the tool call has already happened

# --- LangSmith tracing (optional; development only, keep OFF for latency experiments) ---
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your_langsmith_key_here
# LANGSMITH_PROJECT=pulse-agent
